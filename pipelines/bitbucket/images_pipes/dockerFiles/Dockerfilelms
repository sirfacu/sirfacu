FROM php:8.3-cli as build

RUN apt-get update && apt-get install -y --no-install-recommends \
        unzip zip curl libzip-dev libgd-dev libxml2-dev \
    && pecl install mongodb \
    && docker-php-ext-enable mongodb \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug \
    && echo "xdebug.mode=coverage" > /usr/local/etc/php/conf.d/xdebug.ini \
    && echo "memory_limit = 256M" > /usr/local/etc/php/conf.d/php-memory-limits.ini \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer --version=2.4.4 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

FROM php:8.3-cli

COPY --from=build /usr/local/bin/composer /usr/local/bin/composer
COPY --from=build /usr/local/etc/php /usr/local/etc/php
COPY --from=build /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --from=build /usr/bin/unzip /usr/bin/unzip
COPY --from=build /usr/bin/zip /usr/bin/zip
COPY --from=build /usr/bin/curl /usr/bin/curl
COPY --from=build /usr/lib /usr/lib
COPY --from=build /usr/include /usr/include

# Definir configuraciones adicionales de PHP
ENV PHP_MEMORY_LIMIT=256M
RUN echo "memory_limit = $PHP_MEMORY_LIMIT" > $PHP_INI_DIR/conf.d/php-memory-limits.ini