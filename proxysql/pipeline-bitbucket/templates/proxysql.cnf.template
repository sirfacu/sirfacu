########################################################################################
# IMPORTANT INFORMATION REGARDING THIS CONFIGURATION FILE:                             
########################################################################################
# On startup, ProxySQL reads its config file (if present) to determine its datadir. 
# What happens next depends on if the database file (disk) is present in the defined
# datadir (i.e. "/var/lib/proxysql/proxysql.db").
#
# If the database file is found, ProxySQL initializes its in-memory configuration from 
# the persisted on-disk database. So, disk configuration gets loaded into memory and 
# then propagated towards the runtime configuration. 
#
# If the database file is not found and a config file exists, the config file is parsed 
# and its content is loaded into the in-memory database, to then be both saved on-disk 
# database and loaded at runtime.
#
# IMPORTANT: If a database file is found, the config file is NOT parsed. In this case
#            ProxySQL initializes its in-memory configuration from the persisted on-disk
#            database ONLY. In other words, the configuration found in the proxysql.cnf
#            file is only used to initial the on-disk database read on the first startup.
#
# In order to FORCE a re-initialise of the on-disk database from the configuration file 
# the ProxySQL service should be started with "systemctl start proxysql-initial".
#
########################################################################################

datadir="/var/lib/proxysql"
errorlog="/var/lib/proxysql/proxysql.log"

admin_variables=
{
    admin_credentials="${PROXYSQL_ADMIN_USER}:${PROXYSQL_ADMIN_PWD}"
    mysql_ifaces="127.0.0.1:6032;/tmp/proxysql_admin.sock"
    web_enabled=true
    web_port=8080
}

mysql_variables=
{
	threads=4
	max_connections=3000
	server_version="8.0.4 (ProxySQL)"
	monitor_username="${PROXYSQL_MONITOR_USER}"
	monitor_password="${PROXYSQL_MONITOR_PWD}"
	monitor_history=600000
	monitor_connect_interval=60000
	monitor_ping_interval=10000
	monitor_read_only_interval=1500
	monitor_read_only_timeout=500
  auditlog_filename="/var/lib/proxysql/connections.log"
  auditlog_filesize=10485760
	default_query_delay=0
	default_query_timeout=36000000
	have_compress=true
	poll_timeout=2000
	interfaces="0.0.0.0:${PROXYSQL_PORT}"
	default_schema="information_schema"
	stacksize=1048576
	connect_timeout_server=3000
	ping_interval_server_msec=120000
	ping_timeout_server=500
	commands_stats=true
	sessions_sort=true
	connect_retries_on_failure=10
}


# defines all the MySQL servers
mysql_servers =
(
	{ 
        address="${PROXYSQL_WRITER_ENDPOINT_DNS}"
        port=${PROXYSQL_WRITER_ENDPOINT_PORT} 
        hostgroup=0
        max_connections=5000 
        status = "ONLINE"
        weight = 1
        compression = 0
        max_replication_lag = 10
    },
    ,
    { 
        address="${PROXYSQL_READER_ENDPOINT_DNS}"
        port=${PROXYSQL_READER_ENDPOINT_PORT} 
        hostgroup=1
        max_connections=5000 
        status = "ONLINE"
        weight = 1
        compression = 0
        max_replication_lag = 10
    },
)


# defines all the MySQL users
mysql_users:
(
    ${MYSQL_USERS_DATA}
)
#defines MySQL Query Rules
mysql_query_rules:
(
    {
    rule_id=1
    active=1
    digest="0xDB8B90D1AE6EE4C6"
    destination_hostgroup=1
    cache_ttl=300000
    apply=1
    comment="SELECT value FROM mdl_config WHERE name = ?, Feb28"
  },
  {
    rule_id=2
    active=1
    digest="0xCA68BD853457E98E"
    destination_hostgroup=1
    apply=1
    comment=" SELECT  muuai.mdl_u_company_id  FROM mdl_u_user_additional_info muuai  WHERE muuai.mdl_user_id=?, Feb28"
  },
  {
    rule_id=3
    active=1
    digest="0x0956E17C2B563AE4"
    destination_hostgroup=1
    cache_ttl=5
    apply=1
    comment="SELECT id,sid,state,userid,lastip,timecreated,timemodified FROM mdl_sessions WHERE sid = ?, Feb28"
  },
  {
    rule_id=4
    active=1
    digest="0x2B2AC9705F53F8F0"
    destination_hostgroup=1
    cache_ttl=5
    apply=1
    comment="SELECT mu.id,mu.username,mu.deleted,mu.suspended,mu.firstname,mu.lastname FROM mdl_user mu WHERE mu.id = ?, Feb28"
  },
  {
    rule_id=5
    active=1
    digest="0xDE455BDB04AAD471"
    destination_hostgroup=1
    cache_ttl=5
    apply=1
    comment="SELECT * FROM mdl_user WHERE id = ?, Feb28"
  }
)

